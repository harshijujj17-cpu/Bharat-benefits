# Required provider credentials. Keep real values only in .env or your deployment secret manager.
GEMINI_API_KEY=your-gemini-api-key
TAVILY_API_KEY=your-tavily-api-key

# Gemini generation configuration
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-flash-latest
GEMINI_TIMEOUT_MS=30000

# Tavily live-search timeout in seconds
TAVILY_TIMEOUT_SECONDS=20

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fixed-window rate limiting for endpoints that call Tavily or Gemini
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
